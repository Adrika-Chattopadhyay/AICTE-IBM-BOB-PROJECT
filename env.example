# =============================================================================
# IBM Cloud & Granite Configuration
# =============================================================================
IBM_API_KEY=your_ibm_cloud_api_key_here
IBM_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2
IBM_GRANITE_CHAT_MODEL_ID=ibm/granite-3-8b-instruct
IBM_GRANITE_EMBEDDING_MODEL_ID=ibm/slate-125m-english-rtrvr

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=Smart Farming AI Agent
APP_VERSION=1.0.0
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_strong_random_secret_key_32chars
DEBUG=False
LOG_LEVEL=INFO
LOG_FILE=logs/smart_farming.log

# =============================================================================
# Streamlit Settings
# =============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_THEME=light

# =============================================================================
# Weather API (OpenWeatherMap - Free Tier)
# =============================================================================
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
DEFAULT_COUNTRY_CODE=IN
DEFAULT_LANGUAGE=en

# =============================================================================
# Agmarknet / Mandi Price API (Government of India - Free)
# =============================================================================
AGMARKNET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# =============================================================================
# Soil & Crop Data API
# =============================================================================
SOILGRIDS_API_URL=https://rest.isric.org/soilgrids/v2.0
CROP_DB_API_URL=https://cropdb.example.com/api/v1

# =============================================================================
# IBM Watson Discovery (Optional - for advanced RAG)
# =============================================================================
WATSON_DISCOVERY_API_KEY=your_watson_discovery_api_key_here
WATSON_DISCOVERY_URL=https://api.us-south.discovery.watson.cloud.ibm.com
WATSON_DISCOVERY_PROJECT_ID=your_discovery_project_id_here

# =============================================================================
# Guardrail Configuration
# =============================================================================
# Input Guardrails
MAX_INPUT_LENGTH=2000
MIN_INPUT_LENGTH=3
PROMPT_INJECTION_THRESHOLD=0.85
PII_DETECTION_ENABLED=True
INAPPROPRIATE_CONTENT_THRESHOLD=0.80
MALICIOUS_INPUT_THRESHOLD=0.85

# Output Guardrails
MAX_OUTPUT_LENGTH=5000
HALLUCINATION_THRESHOLD=0.75
TOXICITY_THRESHOLD=0.80
FACTUAL_ACCURACY_MIN_SCORE=0.60
SENSITIVE_INFO_FILTER_ENABLED=True

# Tool Execution Guardrails
ALLOWED_TOOLS=weather,soil,crop,market_price,pest_control,scheme_info
MAX_TOOL_CALLS_PER_SESSION=50
TOOL_TIMEOUT_SECONDS=15
API_RATE_LIMIT_PER_MINUTE=30

# Security Guardrails
JAILBREAK_DETECTION_ENABLED=True
SQL_INJECTION_PREVENTION=True
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ENCRYPTION_KEY=change_this_to_a_strong_fernet_key_here

# Operational Guardrails
MAX_EXECUTION_TIME_SECONDS=60
MAX_TOKENS_PER_REQUEST=2048
MAX_AGENT_ITERATIONS=10
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
MONTHLY_TOKEN_BUDGET=1000000
COST_ALERT_THRESHOLD_USD=10.0

# Human-in-the-Loop Guardrails
HITL_ENABLED=True
FINANCIAL_TRANSACTION_APPROVAL=True
CRITICAL_ACTION_APPROVAL=True
HUMAN_ESCALATION_THRESHOLD=0.50
APPROVAL_TIMEOUT_SECONDS=300

# Multi-Agent Guardrails
MAX_AGENT_HOPS=5
AGENT_COMMUNICATION_SIGNING=True
CROSS_AGENT_VERIFICATION=True
MAX_LOOP_DETECTION_COUNT=3

# Ethical Guardrails
BIAS_DETECTION_ENABLED=True
FAIRNESS_VALIDATION=True
AUDIT_TRAIL_ENABLED=True
EXPLAINABILITY_ENABLED=True
GDPR_COMPLIANCE=True

# =============================================================================
# Database (SQLite for audit trails - no setup required)
# =============================================================================
DATABASE_URL=sqlite:///data/smart_farming_audit.db
AUDIT_LOG_RETENTION_DAYS=90

# =============================================================================
# Redis (Optional - for session caching)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# =============================================================================
# Supported Languages
# =============================================================================
SUPPORTED_LANGUAGES=en,hi,mr,ta,te,kn,gu,pa,bn,ml
DEFAULT_USER_LANGUAGE=en
